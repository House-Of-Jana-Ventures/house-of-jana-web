# Contact form: emails are sent from a Gmail account with a Google app password
# (Google Account > Security > 2-Step Verification > App passwords).
# Without these, development only logs the enquiry; production refuses to send.
GMAIL_USER=jweindia@gmail.com
GMAIL_APP_PASSWORD=
# Where enquiries go (default: jweindia@gmail.com).
CONTACT_TO=jweindia@gmail.com
