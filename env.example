# Contact form: emails are sent from a Gmail account with a Google app password
# (Google Account > Security > 2-Step Verification > App passwords).
# Without these, development only logs the enquiry; production refuses to send.
GMAIL_USER=jweindia@gmail.com
GMAIL_APP_PASSWORD=
# Where enquiries go (default: jweindia@gmail.com).
CONTACT_TO=jweindia@gmail.com

# ── Shop (phase JS1) ─────────────────────────────────────────
# Where the Jana API is (its /api/v1 base).
API_URL=http://localhost:4100/api/v1
# Keep the shop out of search engines until launch; set true at launch.
SHOP_INDEXING=false

# ── Accounts, cart and checkout (phase JS2) ──────────────────
# Sign-in cookies are HTTPS-only in production. Only for trying a production
# build on http://localhost, set COOKIE_SECURE=false.
# COOKIE_SECURE=false
# Razorpay's payment window script. Leave unset (Razorpay's own is used);
# the browser tests point it at the API's stand-in, which a production build
# accepts only with ALLOW_TEST_PAYMENT_SCRIPT=true. Never set these live.
# RAZORPAY_SCRIPT_URL=
# ALLOW_TEST_PAYMENT_SCRIPT=
